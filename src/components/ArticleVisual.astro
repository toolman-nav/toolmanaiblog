---
import DeferredCover from "./DeferredCover.astro";

const { article } = Astro.props;
---

<div class="article-visual" data-cover={article.coverType}>
  {
    article.image ? (
      <DeferredCover src={article.image} alt={`${article.title} 封面`} width={960} />
    ) : (
      <span class="visual-label">{article.title}</span>
    )
  }
</div>
