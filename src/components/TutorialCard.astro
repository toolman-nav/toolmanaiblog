---
import ArticleInfoPanel from "./ArticleInfoPanel.astro";
import ArticleVisual from "./ArticleVisual.astro";
import DeferredCover from "./DeferredCover.astro";
import { blogDetailPath } from "../lib/routes.mjs";

const { article, compact = false } = Astro.props;
const className = compact ? "panel article-row" : "panel tutorial-card";
---

<a class={className} href={blogDetailPath(article)} data-tutorial-id={article.id} data-search-text={`${article.title} ${article.summary} ${article.category}`}>
  {
    compact ? (
      <div class="thumb" data-cover={article.coverType}>
        {article.image ? <DeferredCover src={article.image} alt={`${article.title} 封面`} width={640} /> : <span class="visual-label">{article.title}</span>}
      </div>
    ) : (
      <ArticleVisual article={article} />
    )
  }
  <ArticleInfoPanel article={article} />
</a>
