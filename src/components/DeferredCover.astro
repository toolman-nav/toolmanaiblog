---
import { getImage } from "astro:assets";
const { src, alt = "", width = 640, eager = false } = Astro.props;
let imageSrc = "";
let imageWidth;
let imageHeight;
if (src && typeof src === "object") {
  const optimized = await getImage({ src, width, format: "webp", quality: 70 });
  imageSrc = optimized.src;
  imageWidth = optimized.attributes.width;
  imageHeight = optimized.attributes.height;
} else if (typeof src === "string" && src.trim() && !src.startsWith("data:")) {
  imageSrc = src.trim();
}
---
{imageSrc && <img src={imageSrc} alt={alt} width={imageWidth} height={imageHeight} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" />}
